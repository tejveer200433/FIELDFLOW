{
  "manifest_version": 3,
  "name": "FieldFlow Website Activity",
  "version": "0.3.0",
  "description": "Sends active website hostnames to the local FieldFlow desktop agent during explicit tracking sessions.",
  "incognito": "not_allowed",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:38473/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": { "default_title": "FieldFlow Website Activity", "default_popup": "popup.html" }
}
