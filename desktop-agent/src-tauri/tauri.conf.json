{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FieldFlow Activity Agent",
  "version": "0.1.0",
  "identifier": "com.fieldflow.activity-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FieldFlow Activity Agent",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* ws://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FIELD-FLOW",
    "shortDescription": "FIELD-FLOW employee activity agent",
    "longDescription": "Privacy-preserving employee activity collection for FIELD-FLOW.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
