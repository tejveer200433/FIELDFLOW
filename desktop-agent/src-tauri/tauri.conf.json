{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FieldFlow Activity Agent",
  "version": "0.3.2",
  "identifier": "com.fieldflow.activity-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FieldFlow Activity Agent",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* ws://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNUMzMUNBNjJERDM1NQpSV1JWMHkybUhNUEZDWER6ZWRTU0xGUlFGcnpmTG05eWZHYU55WmJndE01anB6V0RydmhnL3pQdwo=",
      "endpoints": [
        "https://fieldflow-henna.vercel.app/api/activity/agent/releases/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "FIELD-FLOW",
    "shortDescription": "FIELD-FLOW employee activity agent",
    "longDescription": "Privacy-preserving employee activity collection for FIELD-FLOW.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
